{
  "name": "mspnode",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seeds/run.js",
    "test:checkout": "node src/tests/checkoutConcurrency.js",
    "test:smoke": "node src/tests/e2eSmoke.js",
    "test:auth": "node src/tests/authPlatform.js",
    "test:commerce": "node src/tests/commerceFlows.js && node src/tests/commerceHttp.js && node src/tests/commerceLedger.js",
    "test:commerce:seed": "node src/tests/commerceSeed.js",
    "test:platform": "node src/tests/platformFixes.js",
    "test:catalog": "node src/tests/catalogFixes.js && node src/tests/catalogHttp.js",
