    "migrate:catalog": "node src/modules/catalog/migrate.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.18.0",
    "multer": "^2.3.0",
    "nanoid": "^5.1.16",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.15",
    "socket.io": "^4.8.3",
    "zod": "^4.5.4"
  }
