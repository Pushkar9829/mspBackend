# Copy to .env for local development. On Vercel/Render, set the same keys in the dashboard.
PORT=5000
HOST=0.0.0.0
MONGODB_URI=mongodb://127.0.0.1:27017/msp
NODE_ENV=development

# Comma-separated frontend origins. Use https://*.vercel.app to allow Vercel previews.
CORS_ORIGIN=http://localhost:5173,https://msp-react.vercel.app
FRONTEND_URL=https://msp-react.vercel.app

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=8h
JWT_REFRESH_TTL=7d

SUPER_ADMIN_EMAIL=admin@msp.local
SUPER_ADMIN_PASSWORD=ChangeMe123!

UPLOAD_DIR=uploads
MAPS_PROVIDER=stub
MAPS_API_KEY=

# none + secure is required when the frontend is on another domain (Vercel/Render).
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

SEED_ON_START=true
SEED_DEMO=true
