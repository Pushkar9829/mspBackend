# Copy to .env for local development. On Render/Vercel set the same keys in the dashboard.
# NODE_ENV defaults to "production" when unset. Only NODE_ENV=development or test enables the
# developer fallbacks (dev JWT secrets, default admin password, localhost CORS, lax cookies).
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
LOG_LEVEL=info

# Use a replica set (or Atlas) everywhere: checkout/cancel/refund need transactions.
# Local single-node replica set: mongod --replSet rs0, then rs.initiate().
MONGODB_URI=mongodb://127.0.0.1:27017/msp?replicaSet=rs0
# Only for local experiments on a standalone mongod. Never in production.
ALLOW_NO_TRANSACTIONS=false

# Exact origins only, comma-separated. Wildcards ("*", "https://*.vercel.app") are ignored
# because the API uses credentialed requests (refresh cookie).
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Every emailed link points at the storefront (first FRONTEND_URL entry): /verify-email, /reset-password,
# /unsubscribe, /restock/confirm (all ?token=), plus these overridable page paths:
# FRONTEND_ORDER_PATH=/account/orders        # buyer order page  -> /account/orders/:id
# FRONTEND_STAFF_ORDER_PATH=/tenant/orders   # seller order page -> /tenant/orders/:id
# FRONTEND_PRODUCT_PATH=/product             # product page      -> /product/:slug
# Public base URL of this API (used in links/webhooks).
API_URL=http://localhost:5000
# Public URL of this API (webhooks). Emailed links no longer point at the API.
PUBLIC_API_URL=http://localhost:5000

# Required outside development/test: >= 32 random chars each, different from each other.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=8h
JWT_REFRESH_TTL=7d

# Super admin is created on first start (SEED_ON_START=true or `npm run seed`) only if absent.
# An existing account's password is never overwritten. Required outside development/test (>= 12 chars).
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=

# Seeding (both default false). SEED_DEMO creates demo accounts with public passwords: never in production.
SEED_ON_START=false
SEED_DEMO=false
# Model.syncIndexes() on start (default true outside production; set explicitly in production).
SYNC_INDEXES=true
# Run idempotent auth/tenancy data migrations on start (default true).
RUN_MIGRATIONS=true

# Checkout requires a verified email (default true in production, false otherwise).
REQUIRE_EMAIL_VERIFICATION=false

# Cross-site frontend (different domain) needs SameSite=None + Secure.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Uploads. Local disk path; Vercel defaults to /tmp/uploads (ephemeral, per instance) —
# persistent uploads in serverless need object storage.
UPLOAD_DIR=uploads

# Scheduled jobs. CRON_SECRET protects /api/internal/cron/:name (Authorization: Bearer <secret>);
# Vercel Cron sends it automatically. Set DISABLE_IN_PROCESS_JOBS=true when an external
# scheduler drives the cron endpoint instead of node-cron (default true on Vercel).
CRON_SECRET=
DISABLE_IN_PROCESS_JOBS=false

# Audit log retention in days (TTL on createdAt).
AUDIT_RETENTION_DAYS=365

# Maps / geocoding. MAPS_PROVIDER=stub uses a fake geocoder (radius serviceability meaningless).
MAPS_PROVIDER=stub
MAPS_API_KEY=

# Razorpay test or live keys. Online checkout (UPI, card, net banking) charges through Razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Mail (password reset, email verification, orders). Empty SMTP_HOST logs mail in development only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MS₹ <noreply@example.com>

# SMS through MSG91 (Flow API). Indian carriers require DLT registration: one approved
# template id per message type. Leave MSG91_AUTH_KEY blank to log SMS in development only.
MSG91_AUTH_KEY=
MSG91_DLT_ENTITY_ID=
# Fallback template id, plus per-event ids MSG91_TEMPLATE_<EVENT>:
MSG91_TEMPLATE_ID=
MSG91_TEMPLATE_ORDER_PLACED=
MSG91_TEMPLATE_ORDER_CONFIRMED=
MSG91_TEMPLATE_ORDER_STATUS=
MSG91_TEMPLATE_ORDER_SHIPPED=
MSG91_TEMPLATE_ORDER_OUT_FOR_DELIVERY=
MSG91_TEMPLATE_ORDER_DELIVERED=
MSG91_TEMPLATE_ORDER_CANCELLED=
MSG91_TEMPLATE_ORDER_REFUNDED=
MSG91_TEMPLATE_PAYMENT_RECEIVED=
MSG91_TEMPLATE_ACCOUNT_ALERT=

# Notifications & retention.
NOTIFICATION_TTL_DAYS=90
# HMAC secret for email unsubscribe links (random, >= 32 chars in production).
NOTIFICATION_UNSUBSCRIBE_SECRET=
ANALYTICS_RETENTION_DAYS=180

# Delhivery B2C. Pickup name must match the registered warehouse exactly.
# Staging: https://staging-express.delhivery.com  Production: https://track.delhivery.com
DELHIVERY_TOKEN=
DELHIVERY_BASE_URL=https://staging-express.delhivery.com
DELHIVERY_PICKUP_NAME=
DELHIVERY_WEBHOOK_SECRET=
DELHIVERY_DEFAULT_WEIGHT_GRAMS=500
DELHIVERY_DEFAULT_DIMENSIONS_CM=10x10x10
